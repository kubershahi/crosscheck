# Required for SEC EDGAR fair-access policy.
# Use a real email domain — GitHub noreply addresses are often blocked (403).
# Format: "ProjectName Your Name you@domain.com"
SEC_USER_AGENT=Crosscheck Your Name you@domain.com

# Google GenAI / Gemini (used for both development and production profiles)
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# LLM profile: development | production (both use LLM_MODEL_RANK in config.py)
CROSSCHECK_LLM_PROFILE=development

# Embedding device: mps (Apple Silicon) | cpu | cuda
CROSSCHECK_EMBEDDING_DEVICE=mps
